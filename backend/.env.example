# TraceShield AI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000

# Ethereum RPC & WebSocket Infrastructure (Phase 1)
ETH_RPC_URL=https://cloudflare-eth.com
ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_INFURA_KEY

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceshield_db

# External Intelligence & Indexer API Keys
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY

# AI Service Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
